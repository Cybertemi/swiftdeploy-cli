# Generated by swiftdeploy — do not edit manually
# Edit manifest.yaml and run: swiftdeploy init

services:

  # ── API Service ──────────────────────────────────────────
  api:
    image: {{SERVICE_IMAGE}}
    container_name: swiftdeploy-api
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    environment:
      MODE: "{{MODE}}"
      APP_VERSION: "{{APP_VERSION}}"
      APP_PORT: "{{SERVICE_PORT}}"
    volumes:
      - app-logs:/var/log/app
    healthcheck:
      test: ["CMD", "wget", "-qO-",
             "http://localhost:{{SERVICE_PORT}}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 15s
    cap_drop:
      - ALL
    expose:
      - "{{SERVICE_PORT}}"

  # ── Nginx ────────────────────────────────────────────────
  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx-logs:/var/log/nginx
    depends_on:
      api:
        condition: service_healthy

  # ── OPA Policy Agent ─────────────────────────────────────
  # Reachable by swiftdeploy CLI on internal network only
  # NOT exposed through Nginx — no public access
  opa:
    image: openpolicyagent/opa:latest-rootless
    container_name: swiftdeploy-opa
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
      - opa-internal
    volumes:
      - ./policies:/policies:ro
    command:
      - "run"
      - "--server"
      - "--addr=0.0.0.0:8181"
      - "--log-level=error"
      - "/policies"
    expose:
      - "8181"

networks:
  {{NETWORK_NAME}}:
    name: {{NETWORK_NAME}}
    driver: {{NETWORK_DRIVER}}
  # OPA internal network — isolated from public Nginx ingress
  opa-internal:
    name: opa-internal
    driver: bridge

volumes:
  app-logs:
  nginx-logs:
