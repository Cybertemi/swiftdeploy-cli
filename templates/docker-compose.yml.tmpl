# Generated by swiftdeploy — do not edit manually
# Edit manifest.yaml and run: swiftdeploy init

services:

  # ── API Service ──────────────────────────────────────────
  api:
    image: {{SERVICE_IMAGE}}
    container_name: swiftdeploy-api
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    environment:
      MODE: "{{MODE}}"
      APP_VERSION: "{{APP_VERSION}}"
      APP_PORT: "{{SERVICE_PORT}}"
    volumes:
      - app-logs:/var/log/app
    # Health check on /healthz
    healthcheck:
      test: ["CMD", "wget", "-qO-",
             "http://localhost:{{SERVICE_PORT}}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 5s
    # Security — non-root, dropped capabilities
    user: "1000:1000"
    cap_drop:
      - ALL
    # Never expose service port directly
    # All traffic routes through Nginx
    expose:
      - "{{SERVICE_PORT}}"

  # ── Nginx ────────────────────────────────────────────────
  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx-logs:/var/log/nginx
    depends_on:
      api:
        condition: service_healthy

networks:
  {{NETWORK_NAME}}:
    name: {{NETWORK_NAME}}
    driver: {{NETWORK_DRIVER}}

volumes:
  app-logs:
  nginx-logs:
