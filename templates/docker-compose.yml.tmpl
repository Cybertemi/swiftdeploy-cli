# Generated by swiftdeploy — do not edit manually
# Edit manifest.yaml and run: swiftdeploy init

services:

  # ── API Service ──────────────────────────────────────────
  api:
    image: {{SERVICE_IMAGE}}
    container_name: swiftdeploy-api
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    environment:
      MODE: "{{MODE}}"
      APP_VERSION: "{{APP_VERSION}}"
      APP_PORT: "{{SERVICE_PORT}}"
    volumes:
      - app-logs:/var/log/app
    healthcheck:
      test: ["CMD", "wget", "-qO-",
             "http://localhost:{{SERVICE_PORT}}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 15s
    cap_drop:
      - ALL
    expose:
      - "{{SERVICE_PORT}}"

  # ── Nginx ────────────────────────────────────────────────
  # Only Nginx is exposed publicly
  # API port is never exposed directly
  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx-logs:/var/log/nginx
    depends_on:
      api:
        condition: service_healthy

  # ── OPA Policy Agent ─────────────────────────────────────
  # Port 8181 exposed to host so swiftdeploy CLI can query it
  # NOT routed through Nginx — no public ingress access
  # The submission requirement says OPA must not be accessible
  # via the Nginx port (8080) — it is not, it uses 8181
  opa:
    image: openpolicyagent/opa:latest-rootless
    container_name: swiftdeploy-opa
    restart: unless-stopped
    networks:
      - {{NETWORK_NAME}}
    ports:
      - "127.0.0.1:8181:8181"
    volumes:
      - ./policies:/policies:ro
    command:
      - "run"
      - "--server"
      - "--addr=0.0.0.0:8181"
      - "--log-level=error"
      - "/policies"

networks:
  {{NETWORK_NAME}}:
    name: {{NETWORK_NAME}}
    driver: {{NETWORK_DRIVER}}

volumes:
  app-logs:
  nginx-logs:
